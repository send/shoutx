<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WorkerProbe.cs" />
    <Compile Include="UnicodeCandidateProbe.cs" />
    <EmbeddedResource Include="unicode-candidate.json" LogicalName="unicode-candidate.json" />
    <Reference Include="Runner.Common">
      <HintPath>$(RunnerBin)/Runner.Common.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="Runner.Worker"><HintPath>$(RunnerBin)/Runner.Worker.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="Runner.Sdk"><HintPath>$(RunnerBin)/Runner.Sdk.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="Sdk"><HintPath>$(RunnerBin)/Sdk.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
</Project>
